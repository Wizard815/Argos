.aider*
.env
build/
dist/
.vscode
.DS_Store
.dev/

# UI build output; embedded via the `embed_ui` build tag (internal/server/embed.go)
internal/server/ui_dist/*

# Docs Agent eval results; regenerated by evals/docs-agent/run.sh
evals/docs-agent/runs/
evals/config.yaml

# Real, live deploy config (paths, model dirs) — copy deploy/config.yaml.example
# to this path once and edit the copy; see README-DEPLOY.md. Keeping it out of
# git means `git pull` never collides with or overwrites your real config.
deploy/config.yaml
# The live root config: your paths, model dirs and host names. Copy
# config.example.yaml to it locally; it is never tracked.
config.yaml
config.yaml.bak

# Engine output: the model/scheduler files it writes into config.d, found in
# the directory compose mounts. Per-deployment, regenerated on scan - the same
# reason as config.yaml above.
config.d/*.generated.yaml

# setup.sh writes these for one deployment and backs the old ones up as *.bak.
# Your host paths and remote host names belong in your checkout, not in the
# repository: untracked means `git pull` can never collide with them either.
.env.bak
docker-compose.override.yaml
docker-compose.override.yaml.bak

# Python app
builder/__pycache__/
builder/**/__pycache__/
builder/.pytest_cache/
builder/data.db*
builder/runs/
builder/venv/
