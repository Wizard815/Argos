# .env for the root docker-compose.yml (copy to .env and edit)

# Image Argos is built on top of (needs your llama.cpp inside for Mode 1).
BASE_IMAGE=mx-llamacpp-mx-llamacpp-ssh
BASE_TAG=latest

# Host paths
MODELS_DIR=/mnt/user/OnePiece/HomeLab/LLMBin

# ---- GPU backends: uncomment what you use ---------------------------------
# AMD / ROCm: numeric GID of the group owning /dev/kfd and /dev/dri
#   ls -la /dev/kfd /dev/dri && getent group video render
VIDEO_GID=18
# ROCM_IMAGE=mx-llamacpp:latest                     # Mode 2 only

# NVIDIA / CUDA (needs NVIDIA Container Toolkit / Unraid Nvidia-Driver plugin)
# CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda   # Mode 2 only; or your own

# Custom llama.cpp build folder on the host (Mode 2, bk-custom)
# HOST_CUSTOM_BIN=/mnt/user/appdata/my-llama

# vLLM / SGLang Hugging Face cache on the host (Mode 2, manual models)
# HOST_HF_DIR=/mnt/user/appdata/hf-cache
